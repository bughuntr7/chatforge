# 🔥 ChatForge Environment Variables
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ===========================================
# Database Configuration
# ===========================================
DB_URI=postgresql://user:password@localhost:5432/chatforge
DATABASE_URL=postgresql://user:password@localhost:5432/chatforge

# ===========================================
# JWT & Security
# ===========================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# ===========================================
# OpenAI Configuration
# ===========================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ===========================================
# Pinecone Vector Database
# ===========================================
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=knowledge-base
PINECONE_INDEX_DIMENSION=3072
EMBEDDING_MODEL=text-embedding-ada-002

# ===========================================
# Email Configuration (SMTP)
# ===========================================
MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password

# ===========================================
# Stripe Payment Configuration
# ===========================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_ENDPINT_SECRET=whsec_your-stripe-webhook-secret
FRONTEND_DOMAIN=https://yourdomain.com

# ===========================================
# Shopify Integration
# ===========================================
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_SECRET_KEY=your-shopify-secret-key
REDIRECT_URL=https://yourdomain.com/api/shopifyauth

# ===========================================
# Mautic CRM Integration
# ===========================================
MAUTIC_BASE_URL=https://your-mautic-instance.com
MAUTIC_CLIENT_ID=your-mautic-client-id
MAUTIC_CLIENT_SECRET=your-mautic-client-secret

# ===========================================
# File Storage (DigitalOcean Spaces / S3)
# ===========================================
BUCKET_ACCESS_KEY_ID=your-bucket-access-key
BUCKET_SECRET_ACCESS_KEY=your-bucket-secret-key
BUCKET_ENDPOINT=https://your-region.digitaloceanspaces.com
UPLOAD_FOLDER=./uploads

# ===========================================
# External APIs (Optional)
# ===========================================
SERPER_API_KEY=your-serper-api-key
STORM_GLASS_API_KEY=your-storm-glass-api-key
